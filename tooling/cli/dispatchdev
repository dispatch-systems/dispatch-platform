#!/usr/bin/env bash
# Runs the dispatchdev of the checkout this script is in, on the checkout the current
# directory is in. On CI, the tools job's copy runs when it was restored into this
# workspace's own .ci-tools. Anywhere else the binary is built once for each version of its
# source, kept beside the repository's shared Git data, and reused by every worktree. It builds
# in the checkout's own target folder: Cargo copies out only a binary it rebuilt, so a target
# shared by checkouts of different sources hands one of them the other's binary.
set -euo pipefail
# macOS before 15 has no sha256sum, and keeps it in /sbin after.
if command -v sha256sum >/dev/null; then sha256=(sha256sum); else sha256=(shasum -a 256); fi
source=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd -P)
# Its review instructions review a checkout that has none, such as the agent docs'.
export DISPATCHDEV_SOURCE="$source"
prebuilt="$source/.ci-tools/tools/dispatchdev"
if [[ ${CI:-} == true && ${DISPATCH_CI_TOOLS:-} == "$source/.ci-tools" &&
  -f $prebuilt && ! -L $prebuilt && -x $prebuilt ]]; then
  exec "$prebuilt" "$@"
fi
cache="$(git -C "$source" rev-parse --path-format=absolute --git-common-dir)/dispatchdev"
version=$(
  cd "$source"
  {
    find tooling/cli tooling/shared -type f -not -path '*/target/*' -print0 | sort -z | xargs -0 "${sha256[@]}"
    "${sha256[@]}" Cargo.toml Cargo.lock rust-toolchain.toml
  } | "${sha256[@]}" | cut -c1-16
)
binary="$cache/$version/dispatchdev"
if [[ ! -x $binary ]]; then
  (cd "$source" && cargo build --quiet --locked -p dispatchdev-cli --bin dispatchdev --target-dir "$source/target") >&2
  mkdir -p "$cache/$version"
  install -m 755 "$source/target/debug/dispatchdev" "$binary.$$"
  mv -f "$binary.$$" "$binary"
  # The ten newest versions stay, enough for each of a clone's worktrees to run its own; an
  # older one is rebuilt if its source comes back.
  find "$cache" -mindepth 1 -maxdepth 1 -type d -exec ls -dt {} + |
    tail -n +11 | xargs -r rm -rf
fi
exec "$binary" "$@"
