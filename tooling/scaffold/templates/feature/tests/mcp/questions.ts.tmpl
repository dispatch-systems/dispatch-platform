// {{label}}'s agent eval questions. Each expected answer is read straight from the source
// database with SQL of its own, never through the agent API, so a bug in the tool cannot also
// make its own answer right.
{{#tables}}
import { DatabaseSync } from 'node:sqlite';
import path from 'node:path';
{{/tables}}
import type { Question } from '{{toRoot}}tooling/agent-evals/questions.js';

/** The synthetic DSP the eval asks about. */
export type World = { root: string; dsp: string };

export function questions({{#tables}}world{{/tables}}{{^tables}}_world{{/tables}}: World): Question[] {
{{#tables}}
  const db = new DatabaseSync(path.join(world.root, 'dsps', world.dsp, 'data', '{{databaseFile}}'), {
    readOnly: true,
  });
  try {
    const { count } = db.prepare('SELECT count(*) count FROM {{table}}').get() as { count: number };
    return [
      {
        id: '{{slug}}-count',
        ask: 'How many {{label}} items does the DSP have?',
        format: 'End with one line: the number.',
        grade: 'number',
        expected: [String(count)],
        requiredToolEvidence: '"understood"',
      },
    ];
  } finally {
    db.close();
  }
{{/tables}}
{{^tables}}
  return [
    {
      id: '{{slug}}-empty',
      ask: 'Does the DSP have anything in {{label}}?',
      format: 'End with one line: yes or no.',
      grade: 'text',
      expected: ['no'],
      requiredToolEvidence: '"understood"',
    },
  ];
{{/tables}}
}
