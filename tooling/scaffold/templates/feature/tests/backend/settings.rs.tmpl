//! {{label}}'s settings as its backend reads them, against a real store in a temporary
//! directory: what Settings saves for a DSP, each field by its id.
use super::*;
use dispatch_core::{settings, testing};
use serde_json::json;

#[test]
fn reads_what_settings_saves() {
    testing::install(&[{{testCollectors}}], &[&crate::FEATURE]);
    let (_root, store, dsp) = testing::bootstrapped();
    // Its default, until the DSP saves one.
    assert!(!general(&store, &dsp).unwrap().example);
    let owner = testing::a_user(&store);
    let values = json!({"example": true});
    settings::save(&store, &dsp, &owner, &GENERAL, &values, 0, false).unwrap();
    assert!(general(&store, &dsp).unwrap().example);
}
