import {
  test,
  expect,
  login,
  openDsp,
  placeWidgets,
} from '{{toRoot}}core/shell/tests/support/fixtures.js';

// The seeded DSP has every feature switched on, and its owner holds every permission.
test('{{widgetLabel}} shows on Home where a member places it{{#widgetOpens}}, and opens {{widgetOpensLabel}}{{/widgetOpens}}', async ({ page, dispatch }) => {
  const owner = await dispatch.client();
  const dsp = owner.session.dsps.find((d: { name: string }) => d.name === 'Northline Logistics');
{{#owner}}
  await owner.post(`/api/platform/dsps/${dsp.id}/custom-id`, { customId: '{{owner}}' });
  await owner.post(`/api/platform/dsps/${dsp.id}/features`, { feature: '{{name}}', enabled: true });
{{/owner}}
  await placeWidgets(owner, dsp.id, [{ id: '{{widgetId}}', columns: 2, rows: 2 }]);
  await login(page);
  await openDsp(page, dsp.name);
  const widget = page.getByRole('article', { name: '{{widgetLabel}}', exact: true });
  // TODO(scaffold): what it shows of the seeded DSP.
  await expect(widget).toBeVisible();
{{#widgetOpens}}
  await widget.getByRole('link').click();
  await expect(page.getByRole('heading', { name: '{{widgetOpensLabel}}', level: 1 })).toBeVisible();
{{/widgetOpens}}
  // TODO(scaffold): once it draws under its header, check every size it declares, importing
  // expectEverySize from the fixtures: await expectEverySize(page, dsp.id, '{{widgetId}}');
});
