import {
  test,
  expect,
  login,
  openDsp,
} from '{{toRoot}}core/shell/tests/support/fixtures.js';

// The seeded DSP has every feature switched on, and its owner holds every permission.
{{#page}}

test('{{label}} opens from the sidebar of a DSP that has it', async ({ page{{#owner}}, dispatch{{/owner}} }) => {
{{#owner}}
  const owner = await dispatch.client();
  const dsp = owner.session.dsps.find((d: { name: string }) => d.name === 'Northline Logistics');
  await owner.post(`/api/platform/dsps/${dsp.id}/code`, { code: '{{owner}}' });
  await owner.post(`/api/platform/dsps/${dsp.id}/features`, { feature: '{{name}}', enabled: true });
{{/owner}}
  await login(page);
  await openDsp(page, 'Northline Logistics');
  await page.getByRole('link', { name: '{{label}}', exact: true }).click();
  await expect(page.getByRole('heading', { name: '{{label}}', level: 1 })).toBeVisible();
});
{{/page}}
