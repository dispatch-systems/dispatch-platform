//! Who {{label}}'s data names, as Driver Match reads them, by their {{peopleSource}} IDs.
//! TODO(scaffold): write each query for what the feature really keeps. Core's manifest README
//! says what else a connection can tell Driver Match.
{{#ownDatabase}}
use super::storage::STORAGE;
{{/ownDatabase}}
use dispatch_core::manifest::people::{self, KindInfo, People{{#ownSource}}, Source, SourceInfo{{/ownSource}}};

{{#ownSource}}
/// The IDs {{label}} knows people by. Permanent: their IDs are kept under its id.
pub const SOURCE: Source = Source::new(&SourceInfo {
    id: "{{name}}",
    label: "{{label}}",
    order: {{sourceOrder}},
});

{{/ownSource}}
/// Everyone `{{table}}` names by their {{peopleSource}} ID, counted in records.
pub const PEOPLE: People = People::new(
    KindInfo {
        id: "{{name}}",
        order: {{peopleOrder}},
        label: "{{label}}",
        icon: "{{peopleIcon}}",
    },
    {{#ownSource}}SOURCE{{/ownSource}}{{^ownSource}}{{peopleIdent}}::SOURCE{{/ownSource}},
    |store, dsp| {
        people::named(
            &*{{readPeople}},
            "SELECT person_id id,name,min(substr(created_at,1,10)) first,\
             max(substr(created_at,1,10)) last FROM {{table}} WHERE person_id IS NOT NULL \
             GROUP BY person_id,name ORDER BY last DESC",
        )
    },
)
.records("record", |store, dsp| {
    people::records(
        &*{{readPeople}},
        "SELECT person_id id,count(*) count,max(substr(created_at,1,10)) last \
         FROM {{table}} WHERE person_id IS NOT NULL GROUP BY person_id",
    )
});
