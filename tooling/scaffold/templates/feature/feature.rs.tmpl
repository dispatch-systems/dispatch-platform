{{^bare}}
pub const FEATURE: Feature = Feature {
{{#switch}}
    switch: Some(Switch {
        id: "{{name}}",
        label: "{{label}}",
        requires: &[{{requires}}],
    }),
{{/switch}}
{{#permission}}
    permissions: &[
        perm("{{name}}.view", "View {{label}}", {{viewOrder}}),
{{#keeps}}
        perm("{{name}}.collect", "Collect {{label}}", {{collectOrder}}).implies(&["{{name}}.view"]),
{{/keeps}}
    ],
{{/permission}}
{{#api}}
    routes: api::routes::routes,
{{/api}}
{{#keeps}}
    keeps: &[&backend::keeper::{{pascal}}Keeper],
{{/keeps}}
{{#tables}}
    tables: &[("{{database}}", &["{{table}}"])],
    migrations: &[Migrations {
        kind: {{kind}},
        list: &[Migration {
            id: {{migrationId}},
            name: "{{migrationName}}",
            apply: Sql(include_str!("migrations/{{database}}/{{migrationFile}}")),
        }],
    }],
{{/tables}}
{{#mcp}}
    mcp: mcp::MCP,
{{/mcp}}
    ..feature("{{name}}")
};
{{/bare}}
