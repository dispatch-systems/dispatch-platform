//! {{title}}, called as an agent calls it.
use dispatch_core::testing::{self, agent, bootstrapped, call_tool};
use serde_json::json;

#[test]
fn answers_where_{{feature}}_is_on() {
    testing::install(&[{{collectors}}], &[{{features}}]);
    let (_root, db, dsp) = bootstrapped();
    let caller = agent(&db, &[&dsp], &["{{name}}"]);
{{#optional}}
    // Switched off at the DSP, it is refused there; switched on, it answers.
    let owner = testing::platform_owner(&db);
    db.set_feature(&dsp, "{{switchId}}", false, &owner).unwrap();
    assert!(call_tool(&db, &caller, "{{name}}", json!({})).is_err());
    db.set_feature(&dsp, "{{switchId}}", true, &owner).unwrap();
{{/optional}}
    let answer = call_tool(&db, &caller, "{{name}}", json!({})).unwrap();
    assert_eq!(answer, json!({"dsp": db.find_dsp(&dsp).unwrap().name}));
}
