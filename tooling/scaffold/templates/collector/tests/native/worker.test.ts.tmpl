import test from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import type { AddressInfo } from 'node:net';
import { fixture } from '{{toRoot}}core/shell/tests/support/support.js';

// The real Rust driver signs in to a staged copy of {{label}}'s sign-in page through the
// sandbox proxy. Replace the page with what the site serves as the collector learns it.
test(
  '{{label}} signs in through its staged sign-in page',
  { skip: process.env.DISPATCH_TEST_NATIVE !== '1', timeout: 240000 },
  async (t) => {
    let submitted = 0;
    const server = http.createServer(async (req, res) => {
      const url = new URL(req.url!, 'http://fixture.test');
      const html = (body: string) => {
        res.setHeader('content-type', 'text/html');
        res.end(`<html><head><title>{{label}}</title></head><body>${body}</body></html>`);
      };
      if (url.pathname === '/') {
        if (req.headers.cookie?.includes('signed-in=yes'))
          return html('<main id="signed-in"><p data-record="r1">First record</p></main>');
        return html(
          '<form action="/sign-in" method="post"><input name="username"><input name="password" type="password"><button type="submit">Sign in</button></form>',
        );
      }
      if (url.pathname === '/sign-in') {
        let body = '';
        for await (const chunk of req) body += chunk;
        const fields = new URLSearchParams(body);
        submitted++;
        assert.equal(fields.get('username'), 'fixture-user');
        if (fields.get('password') !== 'fixture-password')
          return html('<p id="rejected">That password is not right.</p>');
        res.writeHead(302, { location: '/', 'set-cookie': 'signed-in=yes; Path=/; Max-Age=3600' });
        return res.end();
      }
      res.writeHead(404);
      res.end();
    });
    await new Promise<void>((resolve) => server.listen(0, '127.0.0.1', resolve));
    t.after(async () => {
      server.closeAllConnections();
      await new Promise<void>((resolve) => server.close(() => resolve()));
    });
    const f = await fixture({
      env: {
        DISPATCH_FIXTURE_PROVIDER_URL: `http://fixture.dispatch.invalid:${(server.address() as AddressInfo).port}`,
        DISPATCH_BWRAP_EXECUTABLE:
          process.env.DISPATCH_BWRAP_EXECUTABLE ?? '/usr/local/libexec/dispatch-dev/bwrap',
      },
    });
    t.after(f.close);
    const owner = await f.client();
    const dsp = owner.session.dsps.find((d: { permanent: boolean }) => d.permanent);
    await owner.select(dsp.id);
    const saved = await owner.post('/api/dsp/connections/{{name}}', {
      username: 'fixture-user',
      password: 'fixture-password',
    });
    assert.equal(saved.value.status, 'ready', saved.body);
    assert.equal(submitted, 1);
  },
);
