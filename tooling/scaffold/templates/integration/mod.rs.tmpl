/// Slack method only it calls is answered in fixture mode by its `fixture`, so previews and
/// tests never reach Slack.
pub const INTEGRATION: Integration = Integration {
    needs: &[{{needs}}],
    hears: &[{{hears}}],
{{#heard}}
    heard: Some(heard),
{{/heard}}
    ..integration("slack", ID, "{{label}}")
};
