{
  "name": "dispatch-platform",
  "version": "0.0.19",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "tsx tooling/dev/dev.ts",
    "build": "tsx tooling/build/build.ts",
    "check": "tsc --noEmit",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint/ .",
    "check:ci": "tsx tooling/ci/checks.ts",
    "check:rules": "tsx tooling/ci/rules.ts",
    "check:scaffold": "tsx tooling/scaffold/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx tooling/testing/test.ts",
    "test:ui": "tsx tooling/testing/browser-check.ts",
    "test:smoke": "tsx tooling/testing/browser-check.ts --smoke-only",
    "test:browseros": "python3 tooling/ci/browseros-check.py",
    "test:artifact": "DISPATCH_TEST_ARTIFACT=1 tsx --test tooling/tests/artifact.test.ts",
    "test:feature": "tsx tooling/testing/owner-tests.ts feature",
    "test:collector": "tsx tooling/testing/owner-tests.ts collector",
    "test:core": "tsx tooling/testing/owner-tests.ts core",
    "test:integration": "tsx tooling/testing/owner-tests.ts integration",
    "test:mcp": "tsx tooling/testing/owner-tests.ts mcp",
    "test:app": "tsx tooling/testing/owner-tests.ts app",
    "predev": "tooling/cli/dispatchdev build",
    "pretest": "tooling/cli/dispatchdev build",
    "agents:signin": "tsx tooling/agent-evals/signin.ts",
    "mail:types": "node services/cloudflare-mail/generate-types.mjs",
    "contracts:generate": "tsx tooling/scaffold/cli.ts generate",
    "check:privacy": "python3 tooling/security/scan.py",
    "check:exports": "python3 tooling/security/exports.py",
    "mail:configure": "tsx tooling/mail/mail-config.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.2.4",
    "emojibase-data": "^18.0.0",
    "lucide-react": "^1.69.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.187.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
