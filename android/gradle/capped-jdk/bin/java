#!/usr/bin/env bash
# The Java each app's tests run on (android/build.gradle.kts): Gradle's own, its parent here, run
# under a cap on the size of any file it writes, 1 GB (bash counts in KB), so a test that runs away
# fails on its own write instead of filling the disk. Gradle reads this folder as a Java install.
java=$(readlink /proc/$PPID/exe 2>/dev/null || ps -o comm= -p $PPID)
ulimit -f 1048576 && exec "$java" "$@"
