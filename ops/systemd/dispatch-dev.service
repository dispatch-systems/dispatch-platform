[Unit]
Description=Dispatch independent Dev platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/dispatch-platform/live/.build
EnvironmentFile=%h/dispatch-platform/live/config/platform.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONDONTWRITEBYTECODE=1
# This service listens only on loopback behind dispatch-dev-tunnel.service.
Environment=DISPATCH_TRUSTED_PROXY=cloudflare
ExecStartPre=/usr/bin/python3 %h/dispatch-platform/live/.runtime/management/update-dev.py --root %h/dispatch-platform/live --verify
ExecStart=%h/dispatch-platform/live/.build/services/rust/dispatch-backend serve
Restart=on-failure
RestartSec=5
# Under memory pressure the kernel kills the biggest process, which during a collection is
# Dev's own browser. Only that collection then fails and retries; Dev keeps serving. Dev
# also ranks below other user services (200), the lowest a user service can go.
OOMPolicy=continue
OOMScoreAdjust=100
TimeoutStopSec=45
KillMode=mixed
UMask=0077

[Install]
WantedBy=default.target
